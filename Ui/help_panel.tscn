[node name="Isi" type="RichTextLabel" parent="Panel/MarginContainer/VBoxContainer" unique_id=1519906430]
custom_minimum_size = Vector2(0, 260)
layout_mode = 2
bbcode_enabled = true
text = "[b]Gameplay[/b]
Klik pohon sawit  →  Panen poin
Klik upgrade  →  Beli 1x
Ctrl + Klik upgrade  →  Beli sebanyak mungkin sekaligus

[b]Skill Tree[/b]
Klik kiri icon/tombol  →  Beli skill
Klik kanan icon/tombol  →  Refund skill (hanya run ini)
Klik kanan drag  →  Geser kamera
Scroll / Q E  →  Zoom in/out
Arrow keys  →  Geser kamera
F  →  Reset posisi kamera ke tengah
Klik di luar panel  →  Tutup skill tree

[b]Rebirth[/b]
Rebirth  →  Reset semua progress kecuali skill
Skill yang sudah dibeli sebelum rebirth terkunci permanen
Alokasi skill bisa dibatalkan (klik kanan) sebelum rebirth"
fit_content = true
scroll_active = false

